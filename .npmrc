# The web/api apps were authored against a flat (yarn-style) node_modules and
# import some transitive deps directly (e.g. @dnd-kit/utilities, @tiptap/core).
# The RN/Expo toolchain in mobile/ has its own, much larger set of phantom
# transitive imports (e.g. @expo/metro-runtime) that only surface as bundler
# errors, not typecheck failures — so this stays a broad hoist rather than a
# hand-enumerated allowlist. The one exclusion: @types/react(-dom), which
# workspaces declare at different versions — hoisting
# it too created a real root-level copy *alongside* each package's own
# pnpm-store-linked copy, and TS treats those as structurally-identical but
# nominally different modules (broke radix-ui's `--radix-*` CSSProperties
# augmentation with "two different types with this name exist" errors).
public-hoist-pattern[]=*
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom
# zod and @hookform/resolvers resolve per workspace: one flat hoisted copy can pair
# mismatched majors. Same class of bug as the @types/react exclusion above.
public-hoist-pattern[]=!zod
public-hoist-pattern[]=!@hookform/resolvers
# react-hook-form has only a broad react peer range; a hoisted copy would pull a second
# React into the mobile bundle ("Invalid hook call"). Mobile exact-pins its version (see
# mobile/package.json) so pnpm keeps it nested.
public-hoist-pattern[]=!react-hook-form
# nativewind is only used by mobile; keep it nested under mobile/node_modules
# alongside mobile's own tailwindcss@3.4.1.
public-hoist-pattern[]=!nativewind

# node-linker=hoisted: mobile's native Android build (CMake/ninja) writes and
# rewrites build artifacts directly under the resolved package directory of
# every native dependency (react-native-*, expo-modules-core, ...). Under the
# default isolated linker, that directory is deep inside the shared
# .pnpm/<name>@<version>_<hash>/node_modules/<name> store — confirmed (by
# building the identical CMakeLists.txt from a short path outside node_modules
# and having it succeed) that ninja cannot reliably converge against that path
# on Windows regardless of long-path support or CMake version, producing
# "manifest 'build.ninja' still dirty after 100 tries". Hoisted linking gives
# every package a real, shallow, non-symlinked node_modules/<name> directory,
# which eliminates the failure.
#
# This also fixes a related but distinct failure: Android Gradle Plugin's
# autolinking registers each native module as an included Gradle project
# pointed at its node_modules/<pkg>/android directory. Under the isolated
# linker that directory is a symlink into the pnpm store, and AGP's variant
# resolution doesn't follow it — every native module project reports
# "No matching variant... No variants exist" and :app:compileDebugJavaWithJavac
# fails to resolve its classpath before Gradle ever reaches the CMake step.
# Hoisted linking's real (non-symlinked) node_modules/<pkg> directories avoid
# this too.
node-linker=hoisted
