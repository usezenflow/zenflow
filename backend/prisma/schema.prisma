generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  engineType      = "binary"
  binaryTargets   = "native"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

enum Language {
  VI_VN @map("vi-VN")
  EN_US @map("en-US")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                 String              @id @default(uuid())
  studentProfile     StudentProfile?
  studyPrograms      StudyProgram[]
  studentMarks       StudentMark[]
  studentTermResults StudentTermResult[]
  name               String              @db.VarChar(60)
  email              String              @unique @db.VarChar(255)
  timezone           String              @default("Asia/Saigon") @db.VarChar(50)
  lang               Language            @default(VI_VN)

  /// Gates `/admin/*`; set in the database only
  role UserRole @default(USER)

  /// When the user finished first-run onboarding
  onboardedAt DateTime?

  /// User intent for native push
  allowNotifications Boolean @default(true)

  /// Where the schedule is shown: the phone's calendar or nowhere
  calendarTarget         CalendarTarget @default(NONE)
  /// Alarm before each event; 0 means none. A session's `reminderMinutes` overrides it.
  defaultReminderMinutes Int            @default(30)

  preferenceMatrix          Float[]   @default([])
  preferenceMatrixDecayedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions      Session[]
  sessionEvents SessionEvent[]

  encryptionKeys UserEncryptionKey[]
  devices        UserDevice[]
  sessionSeries  SessionSeries[]
  integrations   Integration[]
  notifications  Notification[]
  slotProposals  SlotProposal[]

  banditArmStates BanditArmState[]

  oauthTokens   OAuthToken[]
  oauthConsents OAuthConsent[]

  // which portal sections / Moodle courses this student is confirmed in
  portalSectionEnrollments PortalSectionEnrollment[]
  lmsCourseEnrollments     LmsCourseEnrollment[]
  placementPlans           PlacementPlan[]
}

/// One arm per local start hour for the LinUCB scheduler
enum SchedulingArm {
  HOUR_00
  HOUR_01
  HOUR_02
  HOUR_03
  HOUR_04
  HOUR_05
  HOUR_06
  HOUR_07
  HOUR_08
  HOUR_09
  HOUR_10
  HOUR_11
  HOUR_12
  HOUR_13
  HOUR_14
  HOUR_15
  HOUR_16
  HOUR_17
  HOUR_18
  HOUR_19
  HOUR_20
  HOUR_21
  HOUR_22
  HOUR_23
}

/// Per-(user, hour arm) LinUCB state, one row per local start hour
model BanditArmState {
  userId    String
  arm       SchedulingArm
  A         Float[]       @default([])
  b         Float[]       @default([])
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, arm])
}

// Per-(user, provider) data-encryption key, itself protected by a per-provider server-held master key
model UserEncryptionKey {
  id               String              @id @default(uuid())
  provider         IntegrationProvider
  // DEK version — bumped when the per-user key itself is rotated
  version          Int
  // Which MASTER_<provider>_ENCRYPTION_KEY_V<n> env secret wrapped `key`.
  masterKeyVersion Int
  // `key` is the DEK AFTER being wrapped
  key              String
  iv               String
  authTag          String
  algorithm        String
  createdAt        DateTime            @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, version])
  @@index([userId])
  @@index([userId, provider, version(sort: Desc)])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// Push registration: `pushToken` is the device's ntfy topic
model UserDevice {
  id         String         @id @default(uuid())
  platform   DevicePlatform
  pushToken  String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastSeenAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Personal API access token
enum SessionType {
  TASK
  ASSIGNMENT
  EXAM
  LECTURE
  DND // do not disturb (non-study time to exclude from scheduling)
}

enum SessionSource {
  USER
  LMS
  PORTAL
  // Placed by the system without a user request, e.g. prep for an exam or assignment.
  AUTO
  // Busy time imported from the phone calendar; never written back
  DEVICE
}

enum CalendarTarget {
  NONE
  DEVICE
}

model Session {
  id              String        @id @default(uuid())
  title           String
  note            String?
  // Where the session takes place
  location        String?
  // DLU exam format (`HinhThucThi`, e.g. "Thi máy"). Set only on an ingested EXAM; null otherwise.
  examFormat      String?
  // Credits of the exam's course
  examCredits     Int?
  examRetake      Boolean?
  durationMinutes Int // positive multiple of 15
  deadline        DateTime? // required for TASK; null for fixed types (ASSIGNMENT/EXAM/LECTURE/DND)
  notBefore       DateTime? // TASK only: never start earlier
  window          String? // TASK only: MORNING | AFTERNOON | EVENING (local time)
  type            SessionType   @default(TASK)
  source          SessionSource @default(USER)

  conflict Boolean @default(false)

  // Soft-delete flag. A user-initiated delete sets this instead of removing the row
  deleted Boolean @default(false)

  scheduledStartTime DateTime? // fixed types (ASSIGNMENT/EXAM/LECTURE/DND) are always scheduled; TASK is placed by the engine
  // Minutes before start; null uses the user's default, 0 means no alarm
  reminderMinutes    Int?
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stamped on every user move/resize of a scheduled TASK
  lastMovedAt DateTime?
  // Set on insert; the daily cap on automatic prep plans counts rows by it.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // First time an LMS calendar showed the assignment without its "add submission" action
  submittedAt DateTime?

  // Why the scheduler picked the start
  placementReason        PlacementReason?
  placementReasonStartAt DateTime?

  events SessionEvent[]

  // The exam, assignment or lecture this prep session exists for
  prepForSessionId       String?
  prepForOccurrenceStart DateTime?
  prepForSession         Session?  @relation("PrepFor", fields: [prepForSessionId], references: [id], onDelete: SetNull)
  prepSessions           Session[] @relation("PrepFor")

  seriesId String? // for series with rrule, only create a representative session and filter sessions belonging to a series whose rrule covers a particular day range
  series   SessionSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  // Stable identity of the upstream DLU item this session mirrors
  externalKey String?

  // The portal's ScheduleStudyUnitID for a portal-ingested LECTURE
  scheduleStudyUnitId String?

  // The Moodle course.id of an LMS-ingested ASSIGNMENT/EXAM
  lmsCourseId Int?

  notifications Notification[]
  slotProposals SlotProposal[]
  // GET /sessions/search uses the `Session_{title,note,location}_unaccent_idx` expression indexes

  @@unique([userId, externalKey])
  @@index([userId, deadline])
  @@index([userId, scheduledStartTime])
  @@index([userId, seriesId, createdAt(sort: Asc)])
  @@index([seriesId, createdAt])
  @@index([userId, scheduleStudyUnitId])
  @@index([userId, lmsCourseId])
  @@index([prepForSessionId])
}

model SessionSeries {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  type      SessionType @default(DND) // recurring DND/ASSIGNMENT/EXAM/LECTURE (via rrule)
  rrule     String? // the recurrence rule of the series (RFC 5545 RRULE, bare)
  exdates   String[]    @default([]) // ISO instants of individually-deleted occurrences (rrule series only)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessions Session[]

  @@index([userId])
}

enum SlotProposalEvent {
  CREATE
  DEADLINE_CHANGE
  MANUAL_RESCHEDULE
}

enum SchedulingModel {
  HEURISTIC
  LINUCB
}

// A/B experiment record for the heuristic-vs-model scheduling comparison
enum PlacementSource {
  PYTHON
  TS_FALLBACK
}

model SlotProposal {
  id                String            @id @default(uuid())
  experimentId      String
  event             SlotProposalEvent
  primaryPolicy     SchedulingModel // the randomized 50/50 assignment for this event
  randomizationSeed String
  observationCount  Int               @default(0) // user's reward-event count at proposal time → stable cold-start buckets

  heuristicProposal Json // proposed schedule / day-repack diffs
  modelProposal     Json? // model proposal — null until the model is wired
  modelVersion      String?
  proposedStartTime DateTime? // primary policy's concrete pick for this session

  // The length-`d` LinUCB context vector for the selected day and the arm behind the chosen slot, kept
  featureVector   Float[]        @default([])
  selectedArm     SchedulingArm?
  // Applied LinUCB slot-score weights
  linucbWeight    Float?
  stabilityWeight Float?

  // Provenance (ADR-0003): which implementation produced the placement
  placementSource PlacementSource @default(PYTHON)
  degradedReason  String? // "timeout" | "breaker_open" | "connect" | "http_5xx" | "version" | "disabled"

  sessionEvents SessionEvent[]

  firstModifiedAt             DateTime? // outcome signals (denormalized, maintained by a later phase)
  firstModificationType       SessionEventType?
  acceptedWithoutModification Boolean?

  pairwiseShown     Boolean          @default(false) // pairwise comparison (later)
  pairwisePositions Json?
  chosenByUser      SchedulingModel?

  timestamp DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([experimentId])
}

// Why the scheduler picked a start (services/bandit/src/core/reason.py).
enum PlacementReason {
  PREFERRED_HOUR
  BEFORE_DEADLINE
  ONLY_FREE_SLOT
  NEAR_CLASS
  MOVED_FOR_DEADLINE
  BEST_AVAILABLE
}

enum SessionEventType {
  CREATE
  MOVE // user drag or resize of a scheduled TASK (graded negative signal)
  SYSTEM_MOVE // scheduler-initiated move (displacement / conflict reschedule): reward 0, no preference update
  KEPT // an unmoved TASK's slot passed: the recommendation stood (rewardScore +1)
  DELETE // a placed TASK was deleted before it started
  EDIT // a session's time, length or reminder was changed outside the scheduler
}

enum SessionEventSource {
  ZENFLOW
  DEVICE
}

/// Range-partitioned by month on `occurredAt`
model SessionEvent {
  id                  BigInt             @default(autoincrement())
  eventType           SessionEventType
  oldSnapshot         Json? // { scheduledStartTime, durationMinutes, type }; null on CREATE/START
  newSnapshot         Json
  rewardScore         Float              @default(0.0) // CREATE 0 · MOVE graded ≤ 0 · START +1 (ADR-0001, ADR-0035)
  dragDistanceMinutes Int? // signed (new − old start); null unless MOVE — for graded reward later
  policy              SchedulingModel? // attribution once a model is live
  // Where the change was made: in Zenflow or on the phone
  source              SessionEventSource @default(ZENFLOW)
  // Shared by every row one user action wrote
  groupId             String?
  occurredAt          DateTime           @default(now())

  // Nullable + SetNull so START / observation-count history survives a session deletion
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // The LinUCB SlotProposal this MOVE / START delivered a reward for, if any
  slotProposalId String?
  slotProposal   SlotProposal? @relation(fields: [slotProposalId], references: [id], onDelete: SetNull)

  userId String // denormalized for partition/range queries
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([id, occurredAt])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([sessionId])
  @@index([slotProposalId])
  @@index([groupId])
}

/// A placement the user has to confirm
model PlacementPlan {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subjectFrom DateTime? // the subject's start when the plan was made (null for a create)
  startAt     DateTime // the subject's planned start
  moves       Json
  createInput Json? // the CreateSessionDto of a create that needs confirmation
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
}

enum IntegrationProvider {
  LMS
  PORTAL
}

// Encrypted LMS/portal credentials, one row per (userId, provider).
model Integration {
  id                   String              @id @default(uuid())
  provider             IntegrationProvider
  // `encryptedCredentials` is the JSON credential blob encrypted
  encryptedCredentials String
  iv                   String?
  authTag              String?
  encryptionVersion    Int
  lastVerifiedAt       DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lmsSyncJobs   LmsSyncJob[]
  portalApiJobs PortalAPIJob[]

  // one independent cadence per sync kind
  schedules         IngestionSchedule[]
  portalEnrollments PortalSectionEnrollment[]
  lmsEnrollments    LmsCourseEnrollment[]
  syncRuns          SyncRun[]

  @@unique([userId, provider])
  @@index([provider, userId])
  @@index([encryptionVersion(sort: Desc)])
}

model Notification {
  id                 String     @id @default(uuid())
  sentAt             DateTime   @default(now())
  readAt             DateTime?
  actionTakenAt      DateTime?
  // Stable machine-readable slug
  eventName          String
  title              String
  content            String
  // The fixed end instant of the session behind this row
  eventEndsAt        DateTime?
  // A CONFLICT row's (see `notificationEventKind`) user's flexible tasks the sync landed on top of
  conflictSessionIds String[]   @default([])
  // A `plan_offer.*` row's pairwise proposal
  slotProposalId     String?
  offerSlots         DateTime[] @default([])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, sentAt(sort: Desc)])
  @@index([slotProposalId])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Per-run job tracking for the LMS watcher
model LmsSyncJob {
  id        String    @id @default(uuid())
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  items LmsSyncJobItem[]
}

model LmsSyncJobItem {
  id           String    @id @default(uuid())
  url          String
  status       JobStatus @default(PENDING)
  attempt      Int       @default(0)
  // Mirrors PortalAPIJobItem field-for-field on purpose
  statusCode   Int?
  responseBody String?
  createdAt    DateTime  @default(now())

  lmsSyncJobId String
  lmsSyncJob   LmsSyncJob @relation(fields: [lmsSyncJobId], references: [id], onDelete: Cascade)

  @@index([lmsSyncJobId])
}

// Same job-tracking shape as LmsSyncJob/LmsSyncJobItem, for the portal API poller.
model PortalAPIJob {
  id        String    @id @default(uuid())
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  items PortalAPIJobItem[]
}

model PortalAPIJobItem {
  id           String    @id @default(uuid())
  url          String
  status       JobStatus @default(PENDING)
  attempt      Int       @default(0)
  statusCode   Int?
  responseBody String?
  createdAt    DateTime  @default(now())

  portalApiJobId String
  portalApiJob   PortalAPIJob @relation(fields: [portalApiJobId], references: [id], onDelete: Cascade)

  @@index([portalApiJobId])
}

// A Moodle course, as it appears in the `course` block of the LMS calendar
model LmsCourse {
  id          String  @id @default(uuid())
  lmsCourseId Int     @unique // Moodle course.id, e.g. 90001 — the upstream identity
  fullName    String
  shortName   String?

  occurrences LmsCourseOccurrence[]
  enrollments LmsCourseEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One student-portal course section
model PortalSection {
  id                  String  @id @default(uuid())
  // The portal's ScheduleStudyUnitID, e.g
  scheduleStudyUnitId String  @unique
  curriculumId        String? // "10AB1001"
  curriculumName      String // "Môn học Mẫu Một"
  yearStudy           String // academic year, "2026-2027"
  termId              String // "HK01" | "HK02" | "HK03"
  groupNo             String? // "Nhóm: 01"
  teacherName         String? // FullName
  roomId              String? // RoomID, "X01.01"
  buildingName        String? // "A27"
  campusName          String? // CampusName / Address

  // Cache coverage of this section's timetable
  timetableRefreshedAt DateTime?
  timetableThroughDate DateTime?

  occurrences PortalSectionOccurrence[]
  enrollments PortalSectionEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The watcher fetches a whole term at a time
  @@index([yearStudy, termId])
}

// The five independently-scheduled kinds of sync work
enum IngestionSyncKind {
  PORTAL_DISCOVERY // DKHP getAllRegistHistory, once per term -> confirmed ScheduleStudyUnitID set
  LMS_DISCOVERY // enrolled-courses      -> confirmed Moodle course id set
  PORTAL_TIMETABLE // DrawingStudentSchedules, one request per remaining ISO week
  PORTAL_EXAM // /api/student/exam, a plain fetch of the term (no cache, no fan-out)
  LMS_CALENDAR // monthly calendar view, MONTHS_PER_RUN requests
}

// One (integration, kind) pair's independent cadence.
model IngestionSchedule {
  id   String            @id @default(uuid())
  kind IngestionSyncKind

  // The claim ordering key AND the compare-and-set token
  nextDueAt     DateTime
  lastClaimedAt DateTime?
  lastRunAt     DateTime?

  // The last pass that finished with every upstream request succeeding
  lastSuccessAt       DateTime?
  // PORTAL_DISCOVERY only: the "<year>/<term>" the last clean pass covered, "" before any
  lastSuccessTerm     String    @default("")
  consecutiveFailures Int       @default(0)

  // How many consecutive passes were served entirely from the occurrence cache
  cacheHitStreak Int @default(0)

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([integrationId, kind])
  // The claim query, verbatim: WHERE kind = ? AND nextDueAt <= now ORDER BY nextDueAt.
  @@index([kind, nextDueAt])
}

// A student's confirmed registration in one portal section
model PortalSectionEnrollment {
  id                  String @id @default(uuid())
  userId              String
  integrationId       String
  scheduleStudyUnitId String

  // The term the set belongs to
  yearStudy String
  termId    String

  // Last discovery pass that listed this registration.
  discoveredAt DateTime
  // First SUCCESSFUL pass that no longer listed it
  droppedAt    DateTime?

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  section     PortalSection @relation(fields: [scheduleStudyUnitId], references: [scheduleStudyUnitId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scheduleStudyUnitId])
  // Fan-out direction: who else is confirmed in this section.
  @@index([scheduleStudyUnitId, droppedAt])
  // Walk direction: which sections may this student be served from cache.
  @@index([userId, droppedAt])
}

// A student's confirmed enrolment in one Moodle course.
model LmsCourseEnrollment {
  id            String @id @default(uuid())
  userId        String
  integrationId String
  lmsCourseId   Int

  // The three signals the current-term filter reads, stored so a disagreement between them is
  courseCategory String?
  startDate      DateTime?
  hidden         Boolean   @default(false)

  // The filter's verdict. ADVISORY while INGESTION_LMS_TERM_FILTER=shadow
  currentTerm Boolean @default(true)

  discoveredAt DateTime
  droppedAt    DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  course      LmsCourse   @relation(fields: [lmsCourseId], references: [lmsCourseId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lmsCourseId])
  @@index([lmsCourseId, droppedAt])
  @@index([userId, droppedAt])
}

// One real, dated meeting of a portal section, shared by every student in it
model PortalSectionOccurrence {
  id                  String @id @default(uuid())
  scheduleStudyUnitId String

  // The meeting day as the upstream row's own DLU_TZ wall clock, 'YYYY-MM-DD'
  meetingDate     String
  periodId        Int
  numberOfPeriods Int

  // The ISO week the row was fetched under
  isoWeek   Int
  yearStudy String
  termId    String

  // The resolved instant and length, on the 15-minute grid
  startsAt        DateTime
  durationMinutes Int

  title       String
  roomId      String?
  teacherName String?

  // First fetch that saw this meeting
  firstSeenAt DateTime
  lastSeenAt  DateTime
  // Set by the first complete fetch of this week that no longer lists the meeting
  canceledAt  DateTime?

  section PortalSection @relation(fields: [scheduleStudyUnitId], references: [scheduleStudyUnitId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleStudyUnitId, meetingDate, periodId])
  @@index([scheduleStudyUnitId, startsAt])
}

// One dated Moodle activity
model LmsCourseOccurrence {
  id          String @id @default(uuid())
  lmsCourseId Int
  externalKey String @unique // "lms:assign:<instance>" | "lms:quiz:<instance>"

  // ASSIGNMENT or EXAM only — parse-lms.ts emits nothing else.
  type            SessionType
  startsAt        DateTime
  durationMinutes Int
  title           String
  note            String?
  location        String?

  firstSeenAt DateTime
  lastSeenAt  DateTime
  canceledAt  DateTime?

  course LmsCourse @relation(fields: [lmsCourseId], references: [lmsCourseId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lmsCourseId, startsAt])
}

// A student's DLU profile (GET /api/student/info plus marks aggregates)
model StudentProfile {
  userId        String @id
  integrationId String

  studentId String?
  fullName  String
  gender    String?
  cohort    String? // "Khóa 47"
  className String? // "CTK47A"
  faculty   String? // marks OlogyName
  major     String? // marks ChuyenNganh

  studyProgramId   String?
  studyProgramName String?

  // Cumulative figures from the latest marks row.
  gpa4          Float?
  gpa10         Float?
  creditsEarned Int?
  ranking       String? // TenXepLoai

  profileFetchedAt DateTime
  marksFetchedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyProgram {
  id             String @id @default(uuid())
  userId         String
  studyProgramId String
  name           String
  type           Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, studyProgramId])
}

// One graded course. Keyed by the portal's ScheduleStudyUnitID so it lines up with
model StudentMark {
  id                  String   @id @default(uuid())
  userId              String
  scheduleStudyUnitId String
  yearStudy           String
  termId              String
  curriculumId        String?
  curriculumName      String
  credits             Int
  score10             Float?
  score4              Float?
  letter              String?
  passed              Boolean?
  note                String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scheduleStudyUnitId])
  @@index([userId, yearStudy, termId])
}

model StudentTermResult {
  id        String @id @default(uuid())
  userId    String
  yearStudy String
  termId    String

  gpa4              Float?
  gpa10             Float?
  creditsEarned     Int?
  cumulativeGpa4    Float?
  cumulativeGpa10   Float?
  cumulativeCredits Int?
  conductScore      Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, yearStudy, termId])
}

// Week-level cache coverage
model PortalWeekCoverage {
  scheduleStudyUnitId String
  weekStart           DateTime @db.Date
  refreshedAt         DateTime

  @@id([scheduleStudyUnitId, weekStart])
}

enum SyncUnitStatus {
  PENDING
  DONE
  FAILED
}

// One fan-out pass for one integration
model SyncRun {
  id            String            @id @default(uuid())
  integrationId String
  kind          IngestionSyncKind
  // "<year>/<term>" for a timetable, "calendar" for LMS.
  scope         String
  totalUnits    Int

  // The claimed IngestionSchedule row this run settles.
  scheduleId     String?
  claimedAt      DateTime?
  dueAt          DateTime?
  cacheHitStreak Int       @default(0)

  servedFromCache Boolean   @default(true)
  notifiedAt      DateTime?
  finishedAt      DateTime?

  integration Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  units       SyncRunUnit[]

  createdAt DateTime @default(now())

  @@index([integrationId, kind, createdAt])
  @@index([finishedAt, createdAt])
}

model SyncRunUnit {
  runId   String
  // Week start "YYYY-MM-DD" or month "YYYY-MM".
  unit    String
  status  SyncUnitStatus @default(PENDING)
  // True when a live request was made for this unit.
  fetched Boolean        @default(false)
  // Lectures this unit created and other rows it updated or removed
  created Int            @default(0)
  changed Int            @default(0)

  run SyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, unit])
}

// Per-window LMS cache state
model LmsCourseWindow {
  lmsCourseId      Int
  // Names the months the view covers, e.g. "2026-10".
  scope            String
  refreshedAt      DateTime
  throughDate      DateTime
  fingerprint      String?
  fingerprintBy    String?
  priorFingerprint String?

  @@id([lmsCourseId, scope])
}

model LmsCourseSeen {
  userId      String
  lmsCourseId Int
  scope       String
  // This student's own last live view of the course in the scope
  fingerprint String?

  @@id([userId, lmsCourseId, scope])
  // Fan-out direction: who last saw this exact view.
  @@index([lmsCourseId, scope, fingerprint])
}

/// An AI assistant registered through dynamic client registration (RFC 7591)
model OAuthClient {
  id        String   @id // the client_id
  name      String?  @db.VarChar(120)
  metadata  Json // the registered client metadata, redirect_uris included
  createdAt DateTime @default(now())

  tokens   OAuthToken[]
  consents OAuthConsent[]
}

enum OAuthTokenKind {
  CODE
  ACCESS
  REFRESH
}

/// A one-time code, access token or refresh token; only the HMAC of the secret is stored
model OAuthToken {
  id            String         @id @default(uuid())
  kind          OAuthTokenKind
  hash          String         @unique
  familyId      String // a code and every token issued from it; revoked together
  scope         String         @default("")
  codeChallenge String? // PKCE, codes only
  redirectUri   String? // codes only
  resource      String? // the MCP URL the token was issued for (RFC 8707)
  expiresAt     DateTime
  usedAt        DateTime? // set once a code or refresh token is spent
  createdAt     DateTime       @default(now())

  clientId String
  client   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientId])
  @@index([familyId])
  @@index([expiresAt])
}

/// A pending authorization request; single use, and bound to the first signed-in user who enters its code
model OAuthConsent {
  id          String    @id @default(uuid()) // the nonce inside the signed request
  userCode    String    @unique // what the user types in the app to approve
  request     String // the signed request the app reads
  redirectUrl String? // where to send the browser once decided; cleared when read
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  clientId String
  client   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
