# Non-secret production settings. Committed, reviewed in PRs, and shipped by
# scripts/deploy/deploy.sh as backend/.env.prod when SECRETS_PROVIDER=vault.
# Secrets never go here: they live in Vault, one set per consumer (docs/ops/vault.md).
# A name present here AND in Vault aborts the deploy.
# A value of REPLACE_ME marks a setting only the operator knows; the deploy refuses to ship it.
# Before the first Vault-mode deploy, diff this against the live .env.prod.

# --- Postgres (must match the initialised database; the password is in Vault) ---
DB_HOST=postgres
POSTGRES_USER=admin
POSTGRES_DB=zenflow-prod
# --- Redis instances (internal Docker networks; each requires its own password from Vault) ---
SESSION_REDIS_HOST=session-redis
RATE_LIMIT_REDIS_HOST=redis-ratelimit
QUEUE_REDIS_HOST=redis-queue
REDIS_KILLSWITCH_HOST=redis-killswitch
REDIS_PUBSUB_HOST=redis-pubsub

# --- Mail (the password is MAIL_PASSWORD in Vault) ---
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USER=postmaster@usezenflow.com
MAIL_FROM=no-reply@usezenflow.com

# --- Sign-in is limited to these email domains (comma separated). Unset = anyone. Prod only. ---
ALLOWED_EMAIL_DOMAINS=dlu.edu.vn

# --- Public addresses: OAuth discovery for AI assistants (docs/backend/config.md) ---
PUBLIC_API_URL=https://api.usezenflow.com/api/v1
PUBLIC_WEB_URL=https://app.usezenflow.com

# --- Object storage (keys are in Vault) ---


# --- Web ---
CORS_ORIGIN=https://usezenflow.com,https://app.usezenflow.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Backups (IAM keys and BACKUP_AGE_IDENTITY are in Vault) ---
BACKUP_S3_BUCKET=zenflow-backups
BACKUP_S3_REGION=us-east-1
# age PUBLIC keys, comma separated: the master key and the restore-test key.
BACKUP_AGE_RECIPIENT=age1t5caueq683ase8ga4whjj5h0v80jj9nyj0a5kta5v62yarhvzpzse53dmt,age16kj9xqxgsu3f9kn99d35g0jduv2uq8ghg9qmfxsuvn3lfwq3ncds43kaq9

# --- Observability / logging ---
LOG_LEVEL=info
OTEL_SERVICE_NAME=zenflow-api

# Optional: false is the default, and correct for port 587 with STARTTLS.
MAIL_SECURE=false
SESSION_TTL_MS=604800000
DKHP_API_URL=https://dkhp-api.dlu.edu.vn
PORTAL_API_URL=https://portal-api.dlu.edu.vn
PORTAL_API_TIMEOUT_MS=10000
LMS_URL=https://lms.dlu.edu.vn
LMS_TIMEOUT_MS=15000
DLU_TZ=Asia/Ho_Chi_Minh
INGESTION_ENABLED=true
INGESTION_REQUEST_DELAY_MS=750
INGESTION_TIMETABLE_PERIOD_MS=43200000
INGESTION_OCCURRENCE_CACHE_ENABLED=true
PAIRWISE_SAMPLE_RATE=1
APNS_PRODUCTION=true
# Web Push. The public key is also built into the web app as VITE_VAPID_PUBLIC_KEY.
# The subject is a contact URI for the push services (mailto: or https:), not a notification title.
VAPID_PUBLIC_KEY=BI4ngia2RtsFoc-JkGcBCP_TPCvWcakiTsPg4h8HHboq8AfYG-p2h2EY9C4PJBBtPo9IE8bmc6UO4iiHNOzPypY
VAPID_SUBJECT=mailto:alpha@usezenflow.com

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
HTTP_SLOW_REQUEST_MS=1000
