{
  "name": "mobile",
  "main": "index.ts",
  "version": "1.0.0-beta.17",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "cd .. && patch-package --patch-dir mobile/patches",
    "dev": "expo start --dev-client --clear",
    "dev:web": "expo start -c --web",
    "dev:android": "expo start -c --android",
    "dev:ios": "expo start -c --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:personal-team": "expo prebuild --platform ios --clean && node scripts/fixup-ios-personal-team.js && node scripts/run-ios-device.js",
    "web": "EXPO_USE_FAST_RESOLVER=1  expo start -c --web",
    "export": "expo export -p web",
    "format": "biome check --no-errors-on-unmatched --apply .",
    "expo-check": "expo install --check",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "vitest run",
    "test:component": "vitest run -c vitest.component.config.ts",
    "e2e": "bash e2e/run.sh",
    "e2e:screenshots": "bash e2e/screenshots.sh"
  },
  "dependencies": {
    "@bacons/text-decoder": "^0.0.0",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@zenflow/core": "workspace:*",
    "@zenflow/shared": "workspace:*",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "58.0.19",
    "expo-asset": "~58.0.18",
    "expo-blur": "~58.0.5",
    "expo-calendar": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^0.314.0",
    "nativewind": "4.1.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.64.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "happy-dom": "^20.14.5",
    "msw": "^2.15.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "3.4.1",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
