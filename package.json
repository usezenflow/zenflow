{
  "name": "zenflow",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0-beta.17",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "shared:build": "pnpm --filter @zenflow/shared build",
    "core:build": "pnpm --filter @zenflow/core build",
    "check": "pnpm shared:build && pnpm -r typecheck",
    "sync:agents": "node scripts/sync-agents.mjs",
    "test:agents": "node --test .agents/hooks/hooks.test.mjs && node .agents/scripts/owner.mjs --check && node scripts/sync-agents.mjs --check",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs && pnpm install --lockfile-only"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@nestjs/core",
      "unrs-resolver",
      "@scarf/scarf"
    ],
    "overrides": {
      "sharp": "0.32.6",
      "sharp-ico": "0.1.5",
      "jest-environment-node": "30.4.1",
      "@types/react": "19.3.0",
      "lightningcss": "1.30.1",
      "@types/mjml": "4.7.4"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "*"
        },
        "peerDependenciesMeta": {
          "zod": {
            "optional": true
          }
        }
      }
    },
    "allowUnusedPatches": true,
    "patchedDependencies": {
      "unimodules-app-loader@58.0.2": "patches/unimodules-app-loader@58.0.2.patch"
    }
  },
  "dependencies": {
    "expo": "58.0.19",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
